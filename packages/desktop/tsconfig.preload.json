{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // The preload runs before ESM is available in a sandboxed renderer, so it
    // is the one file in the project emitted as CommonJS.
    "module": "CommonJS",
    "moduleResolution": "Node",
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "verbatimModuleSyntax": false,
    "rootDir": "src",
    "outDir": "dist"
  },
  "include": ["src/preload.cts"]
}
