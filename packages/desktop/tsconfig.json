{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Node types ARE allowed here, and only here on the game side: this is the
    // process that owns a real socket and a real window. Everything it talks to
    // stays platform-free.
    "lib": ["ES2022"],
    "types": ["node"],
    "rootDir": "src",
    // Declarations only. esbuild produces the runtime files in `dist`, because
    // tsc emits bare `@rts/transport` imports that cannot resolve inside a
    // packaged asar -- see scripts/build-desktop.mjs.
    "outDir": "dist-types",
    "emitDeclarationOnly": true,
    "paths": {
      "@rts/transport": ["../transport/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.test.ts"],
  "references": [{ "path": "../transport" }]
}
