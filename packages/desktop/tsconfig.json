{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Node types ARE allowed here, and only here on the game side: this is the
    // process that owns a real socket and a real window. Everything it talks to
    // stays platform-free.
    "lib": ["ES2022"],
    "types": ["node"],
    "rootDir": "src",
    "outDir": "dist",
    "paths": {
      "@rts/transport": ["../transport/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.test.ts"],
  "references": [{ "path": "../transport" }]
}
