{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // The only package that legitimately needs Node types: it is the one
    // process that actually runs on a server rather than in a browser.
    "lib": ["ES2022"],
    "types": ["node"],
    "rootDir": "src",
    "outDir": "dist"
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.test.ts"]
}
