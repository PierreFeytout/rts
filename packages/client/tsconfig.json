{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "rootDir": "src",
    "outDir": "dist-types",
    // Vite produces the shippable JS; tsc here exists purely to typecheck and
    // to satisfy project references, so emitting JS as well is wasted work.
    "emitDeclarationOnly": true,
    "paths": {
      "@rts/sim": ["../sim/src/index.ts"],
      "@rts/transport": ["../transport/src/index.ts"],
      "@rts/protocol": ["../protocol/src/index.ts"],
      "@rts/netcode": ["../netcode/src/index.ts"],
      "@rts/content": ["../content/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts"],
  "references": [
    { "path": "../sim" },
    { "path": "../transport" },
    { "path": "../protocol" },
    { "path": "../netcode" },
    { "path": "../content" }
  ]
}
