# Copy to docker/.env and fill in before running the tls or turn profiles.

# The hostname players will type. Must already point at this machine, or
# Caddy's certificate request will fail.
DOMAIN=rts.example.com
ACME_EMAIL=you@example.com

# Only needed with --profile turn. TURN_URL is what the broker hands to
# clients at /ice; it must be reachable from the public internet.
TURN_URL=turn:rts.example.com:3478
TURN_USER=rts
TURN_PASSWORD=change-me
